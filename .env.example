# Public
NEXT_PUBLIC_SITE_URL=https://proxy-relationship-demo.vercel.app

# Demo email delivery
# preview = validates the flow without sending an email
# live = sends through the configured provider
EMAIL_DELIVERY_MODE=preview
EMAIL_PROVIDER=brevo

# Live mode safety: only these recipients may receive demo messages.
# Comma-separated addresses.
DEMO_ALLOWED_RECIPIENTS=

# Brevo — server only
BREVO_API_KEY=
BREVO_SENDER_NAME=Texfield
BREVO_SENDER_EMAIL=
BREVO_REPLY_TO=

# CTA used in the demonstration email
TEXFIELD_DEMO_CTA_URL=https://texfield.com.br

# WhatsApp conversational demo
WHATSAPP_DEMO_MODE=preview
WHATSAPP_DEMO_AI_MODE=preview
WHATSAPP_DEMO_GRAPH_VERSION=v26.0
WHATSAPP_DEMO_VERIFY_TOKEN=
WHATSAPP_DEMO_APP_SECRET=
WHATSAPP_DEMO_ACCESS_TOKEN=
WHATSAPP_DEMO_PHONE_NUMBER_ID=
WHATSAPP_DEMO_ALLOWED_NUMBERS=
WHATSAPP_DEMO_SESSION_SECRET=
CONVERSATIONAL_AI_MODEL=gpt-5.6-luna
DATABASE_URL=
OPENAI_API_KEY=
