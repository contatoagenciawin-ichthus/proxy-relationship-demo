# Public
NEXT_PUBLIC_SITE_URL=https://proxy-relationship-demo.vercel.app

# Demo email delivery
# preview = validates the flow without sending an email
# live = sends through the configured provider
EMAIL_DELIVERY_MODE=preview
EMAIL_PROVIDER=brevo

# Live mode safety: only these recipients may receive demo messages.
# Comma-separated addresses.
DEMO_ALLOWED_RECIPIENTS=

# Brevo — server only
BREVO_API_KEY=
BREVO_SENDER_NAME=Texfield
BREVO_SENDER_EMAIL=
BREVO_REPLY_TO=

# CTA used in the demonstration email
TEXFIELD_DEMO_CTA_URL=https://texfield.com.br


# Editorial image generation
# preview = validates prompt/flow without consuming image generation
# live = calls OpenAI, stores the image in Vercel Blob and persists metadata in Neon
EDITORIAL_IMAGE_MODE=preview

# OpenAI — server only
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_IMAGE_SIZE=1536x1024
OPENAI_IMAGE_QUALITY=low
OPENAI_IMAGE_FORMAT=jpeg
OPENAI_IMAGE_COMPRESSION=84

# Demo cost/safety guard
DEMO_IMAGE_MAX_PER_HOUR=8

# Vercel Blob — server only
BLOB_READ_WRITE_TOKEN=

# Neon — application uses pooled URL; migrations should use the direct URL
DATABASE_URL=
DATABASE_URL_UNPOOLED=
